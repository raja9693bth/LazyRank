# ========================================================
# LAZYPROOF / LAZY (OPERATED BY ADABHRA GROUP)
# ENVIRONMENT CONFIGURATION SPECIFICATION
# ========================================================

# Host environment
NODE_ENV="production"
PORT=3000

# Canonical Public App URL
APP_URL="https://lazyproof.online"

# AI Studio / Gemini API Key (Optional: for AI roast generation)
GEMINI_API_KEY=""

# Admin API Secret (Required: for authorized moderation & refunds)
ADMIN_KEY="generate_a_secure_random_64_character_admin_key"

# Production Database (Neon Serverless PostgreSQL Connection URI)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@ep-[PROJECT_NAME]-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Payment Gateway Operational Mode (Strict: 'disabled' | 'sandbox' | 'live')
# In production, PAYMENT_MODE must be 'disabled' (pending approval) or 'live' (after approval).
# PAYMENT_MODE='sandbox' in production will fail-fast with a fatal configuration error.
PAYMENT_MODE="disabled"

# Cashfree Payment Gateway Credentials (API Version 2023-08-01 / 2026-01-01)
# Required ONLY when PAYMENT_MODE="live" or PAYMENT_MODE="sandbox"
# Note: CASHFREE_SECRET_KEY is used for both PG API calls and official webhook HMAC-SHA256 signature verification.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_API_VERSION="2026-01-01"

# Merchant Tax & GST Verification Flags
# Section 22 of the CGST Act concerns registration thresholds.
# Unregistered status disclosure ("Unregistered (Turnover below threshold under Section 22 CGST Act) — ₹0")
# may ONLY be enabled after contemporaneous evidence of unregistered status, aggregate turnover,
# place of supply analysis, and external tax-professional sign-off are documented outside Git.
# If evidence is absent, leave these unset/empty so checkout safely fails closed with "GST status being verified".
# Valid values: MERCHANT_TAX_BASIS="verified_unregistered_below_threshold" and MERCHANT_TAX_REVIEWED="true"
MERCHANT_TAX_BASIS=""
MERCHANT_TAX_REVIEWED="false"

# Founder Operational Alert Outbox (Optional Telegram & Discord channels)
# Code reads: TELEGRAM_BOT_TOKEN, TELEGRAM_ADMIN_CHAT_ID, DISCORD_WEBHOOK_URL
# When unconfigured, alerts are marked as SKIPPED_NO_CHANNELS and never blast historical alerts.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
DISCORD_WEBHOOK_URL=""

VOTE_SECRET=""
